{
  "manifest_version": 3,
  "name": "Auto Fill Khảo Sát",
  "version": "1.5",
  "description": "Tiện ích hỗ trợ tự động điền phiếu đánh giá môn học/khảo sát bằng Side Panel.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "action": {
    "default_title": "Mở Bảng Điều Khiển Auto Fill",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
